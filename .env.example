# ============================================
# AI-IGOT PLATFORM - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/ai_igot_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_igot_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password

# ============================================
# BACKEND SERVER
# ============================================
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# OTP CONFIGURATION
# ============================================
# Choose: twilio, msg91, firebase, or development
OTP_PROVIDER=twilio
OTP_DEV_FALLBACK_ENABLED=false

# SMS provider configuration
# Choose one provider in OTP_PROVIDER and populate the corresponding values below.

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_service_sid

# MSG91 Configuration
MSG91_API_KEY=your_api_key
MSG91_SENDER_ID=your_sender_id

# Firebase Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# ============================================
# OTP SETTINGS
# ============================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6
OTP_RESEND_DELAY_SECONDS=30

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================
# AI/LLM CONFIGURATION
# ============================================
# Choose: openai, anthropic, google, fallback
AI_PROVIDER=fallback

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-sonnet

# Google Configuration
GOOGLE_AI_API_KEY=your_google_ai_api_key

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads/materials
ALLOWED_FILE_TYPES=pdf,docx,pptx,txt
PDF_EXTRACTION_SERVICE=pdfplumber

# ============================================
# iGOT KARMAYOGI INTEGRATION
# ============================================
# Set to true when authorized API is available
IGOT_API_ENABLED=false
IGOT_API_KEY=your_igot_api_key
IGOT_API_URL=https://api.igot-karmayogi.gov.in

# ============================================
# EMAIL CONFIGURATION (for notifications)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@ai-igot.in
SMTP_FROM_NAME=AI-IGOT Platform

# ============================================
# APPLICATION SETTINGS
# ============================================
# Local-only development fallback. Keep false in production.
# This only allows a non-SMS development route when OTP_PROVIDER=development.
DEMO_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# ============================================
# SECURITY
# ============================================
# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ============================================
# CERTIFICATE GENERATION
# ============================================
CERTIFICATE_ISSUER_NAME=Ministry of Statistics & Programme Implementation
CERTIFICATE_ORGANIZATION=Government of India
CERTIFICATE_VALIDITY_YEARS=2

# ============================================
# NOTIFICATION SETTINGS
# ============================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
NOTIFICATION_QUEUE_TYPE=in_memory

# Options: in_memory, redis, celery
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# ============================================
# AWS S3 (Optional - for file storage)
# ============================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=ai-igot-bucket
# AWS_S3_REGION=ap-south-1

# ============================================
# MONITORING & ANALYTICS
# ============================================
# SENTRY_DSN=your_sentry_dsn
# DATADOG_API_KEY=your_datadog_api_key

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_OTP_ENABLED=true
FEATURE_AI_QUIZ=true
FEATURE_FILE_UPLOAD=true
FEATURE_CERTIFICATES=true
FEATURE_IGOT_INTEGRATION=false
